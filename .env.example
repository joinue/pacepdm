# PACE PDM — environment variables
# Copy this file to .env.local for local development. In production, set
# these in your hosting provider's environment (e.g. Vercel project settings).
# All NEXT_PUBLIC_* vars are inlined at build time and visible in the browser.

# ─── Supabase (required) ─────────────────────────────────────────────
# From https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key with full DB access. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App URLs (required) ─────────────────────────────────────────────
# Public origin where the app is reachable (used for redirect URLs,
# share links, email links, etc.).
NEXT_PUBLIC_APP_URL=https://app.example.com

# Server-side equivalent. Usually the same as NEXT_PUBLIC_APP_URL.
APP_URL=https://app.example.com

# Optional marketing site URL (shown in the logo link on auth pages).
# If your app and marketing site share an apex domain (app.example.com /
# example.com), this can be omitted — the logo will infer the marketing
# URL by stripping the "app." subdomain.
NEXT_PUBLIC_MARKETING_URL=https://example.com

# ─── Email (required for invites, password resets, approval reminders) ─
# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_your_key

# From-address for system emails. Must be on a verified Resend domain.
EMAIL_FROM=PACE PDM <noreply@example.com>

# ─── Cron (required for scheduled jobs) ──────────────────────────────
# Shared secret protecting /api/cron/* endpoints. Set the same value in
# your scheduler (Vercel Cron, GitHub Actions, etc.) and pass it as the
# Authorization header: "Bearer $CRON_SECRET".
CRON_SECRET=generate-a-long-random-string

# ─── End-to-end tests (Playwright) ───────────────────────────────────
# The suite creates records and invites users, with no teardown, in the
# workspace of the E2E_EMAIL account. Make that account the Admin of a
# workspace used only for testing — never a member of the team's.
# The suite refuses to run unless E2E_SUPABASE_PROJECT names the Supabase
# project (the ref in https://<ref>.supabase.co) that a local app is using.
# E2E_SUPABASE_PROJECT=
# E2E_BASE_URL=http://localhost:3000
# E2E_EMAIL=
# E2E_PASSWORD=
# An address you control; each run invites <local>-<timestamp>@<domain>.
# The invite test is skipped without it, rather than emailing a dead domain.
# E2E_INVITE_EMAIL_BASE=
